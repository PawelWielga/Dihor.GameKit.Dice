{
  "name": "@dihor/gamekit-dice",
  "version": "0.1.0-preview.1",
  "description": "Reusable framework-agnostic 3D dice rolling library for games and applications.",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "./dist/dihor-gamekit-dice.js",
  "module": "./dist/dihor-gamekit-dice.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/dihor-gamekit-dice.js"
    },
    "./appearance": {
      "types": "./dist/appearance/index.d.ts",
      "import": "./dist/appearance.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core.js"
    },
    "./events": {
      "types": "./dist/events/index.d.ts",
      "import": "./dist/events.js"
    },
    "./overlay": {
      "types": "./dist/overlay/index.d.ts",
      "import": "./dist/overlay.js"
    },
    "./advanced": {
      "types": "./dist/advanced.d.ts",
      "import": "./dist/advanced.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "test": "vitest run && npm run test:api-contract",
    "test:watch": "vitest",
    "test:consumer": "tsc -p tsconfig.consumer.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev:demo": "vite --config vite.demo.config.ts",
    "build:demo": "vite build --config vite.demo.config.ts",
    "preview:demo": "vite preview --config vite.demo.config.ts",
    "test:api-contract": "node scripts/check-public-api-contract.mjs",
    "update:api-contract": "node scripts/check-public-api-contract.mjs --write",
    "test:browser": "node scripts/run-browser-smoke.mjs"
  },
  "dependencies": {
    "@fontsource/cinzel": "5.3.0",
    "cannon-es": "0.20.0",
    "three": "0.186.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/three": "0.186.0",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PawelWielga/Dihor.GameKit.Dice.git"
  },
  "bugs": {
    "url": "https://github.com/PawelWielga/Dihor.GameKit.Dice/issues"
  },
  "homepage": "https://github.com/PawelWielga/Dihor.GameKit.Dice#readme",
  "keywords": [
    "dice",
    "3d",
    "three.js",
    "cannon-es",
    "physics",
    "typescript",
    "dihor",
    "gamekit",
    "games"
  ]
}
